<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flyer Gallery - MindfulOpus</title>
  <link rel="shortcut icon" href="/images/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/vendor/css/bootstrap.min.css" type="text/css">
  <link rel="stylesheet" href="/assets/vendor/css/materialdesignicons.min.css" type="text/css">
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: 'Quicksand', sans-serif;
      background: #f7f6f3;
      color: #333;
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    /* ---- Top bar ---- */
    .flyer-topbar {
      background: linear-gradient(135deg, #1c3d3d 0%, #1a2f2f 100%);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .flyer-topbar-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .flyer-topbar-brand img {
      height: 30px;
      filter: brightness(0) invert(1);
      opacity: 0.9;
    }

    .flyer-topbar-brand span {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 500;
      color: #fff;
      letter-spacing: 0.5px;
    }

    .flyer-topbar-home {
      font-family: 'Quicksand', sans-serif;
      font-size: 13px;
      font-weight: 500;
      color: #5abfbf;
      text-decoration: none;
      letter-spacing: 0.5px;
      transition: color 0.2s;
    }

    .flyer-topbar-home:hover {
      color: #fff;
    }

    /* ---- Page header ---- */
    .flyer-page-header {
      text-align: center;
      padding: 48px 24px 32px;
    }

    .flyer-page-header h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 42px;
      font-weight: 300;
      font-style: italic;
      color: #1c3d3d;
      margin: 0 0 8px;
    }

    .flyer-page-header p {
      font-size: 15px;
      font-weight: 400;
      color: #888;
      margin: 0;
      letter-spacing: 0.3px;
    }

    /* ---- Card grid ---- */
    .flyer-grid {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px 64px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 28px;
    }

    .flyer-card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      transition: transform 0.2s, box-shadow 0.2s;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
    }

    .flyer-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 28px rgba(0,0,0,0.1);
    }

    .flyer-card-preview {
      position: relative;
      background: #eae8e4;
      padding: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 200px;
    }

    .flyer-card-preview iframe {
      border: none;
      background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      pointer-events: none;
    }

    .flyer-card-preview-portrait iframe {
      width: 163px;
      height: 211px;
      transform: scale(1);
    }

    .flyer-card-preview-landscape iframe {
      width: 288px;
      height: 162px;
      transform: scale(1);
    }

    .flyer-card-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .flyer-card-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 500;
      font-style: italic;
      color: #1a1a1a;
      margin: 0 0 8px;
      line-height: 1.25;
    }

    .flyer-card-school {
      font-size: 13px;
      font-weight: 600;
      color: #2a7d7d;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }

    .flyer-card-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: auto;
      padding-top: 12px;
    }

    .flyer-card-date {
      font-size: 13px;
      font-weight: 400;
      color: #999;
    }

    .flyer-card-badge {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 12px;
    }

    .badge-portrait {
      color: #2a7d7d;
      background: rgba(42, 125, 125, 0.1);
      border: 1px solid rgba(42, 125, 125, 0.2);
    }

    .badge-landscape {
      color: #b08d57;
      background: rgba(176, 141, 87, 0.1);
      border: 1px solid rgba(176, 141, 87, 0.2);
    }

    /* ---- Viewer overlay ---- */
    .flyer-viewer-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(20, 20, 20, 0.92);
      flex-direction: column;
    }

    .flyer-viewer-overlay.active {
      display: flex;
    }

    .flyer-viewer-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 24px;
      background: rgba(0,0,0,0.4);
      flex-shrink: 0;
    }

    .flyer-viewer-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      font-weight: 400;
      font-style: italic;
      color: #fff;
    }

    .flyer-viewer-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .flyer-viewer-btn {
      font-family: 'Quicksand', sans-serif;
      font-size: 13px;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      padding: 8px 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s;
    }

    .flyer-viewer-btn-close {
      background: rgba(255,255,255,0.15);
      color: #fff;
    }

    .flyer-viewer-btn-close:hover {
      background: rgba(255,255,255,0.25);
    }

    .flyer-viewer-btn-download {
      background: #2a7d7d;
      color: #fff;
    }

    .flyer-viewer-btn-download:hover {
      background: #1c5c5c;
    }

    .flyer-viewer-btn-newtab {
      background: rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.8);
    }

    .flyer-viewer-btn-newtab:hover {
      background: rgba(255,255,255,0.2);
    }

    .flyer-viewer-frame {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow: auto;
    }

    .flyer-viewer-frame iframe {
      border: none;
      background: #fff;
      box-shadow: 0 4px 40px rgba(0,0,0,0.3);
    }

    /* ---- Footer ---- */
    .flyer-footer {
      text-align: center;
      padding: 24px;
      color: #bbb;
      font-size: 13px;
    }

    .flyer-footer a {
      color: #2a7d7d;
      text-decoration: none;
    }

    /* ---- Responsive ---- */
    @media (max-width: 768px) {
      .flyer-page-header h1 {
        font-size: 32px;
      }

      .flyer-grid {
        grid-template-columns: 1fr;
        padding: 0 16px 48px;
      }

      .flyer-card-preview {
        min-height: 160px;
        padding: 16px;
      }

      .flyer-card-preview-portrait iframe {
        width: 130px;
        height: 168px;
      }

      .flyer-card-preview-landscape iframe {
        width: 240px;
        height: 135px;
      }

      .flyer-viewer-frame {
        padding: 12px;
      }

      .flyer-viewer-frame iframe {
        width: 100% !important;
        height: 100% !important;
      }

      .flyer-viewer-toolbar {
        flex-wrap: wrap;
        gap: 8px;
      }

      .flyer-viewer-title {
        width: 100%;
        font-size: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Top bar -->
  <div class="flyer-topbar">
    <a href="/" class="flyer-topbar-brand">
      <img src="/assets/images/logos/5.png" alt="MindfulOpus">
      <span>MindfulOpus</span>
    </a>
    <a href="/" class="flyer-topbar-home">
      <i class="mdi mdi-arrow-left"></i> Back to Site
    </a>
  </div>

  <!-- Page header -->
  <div class="flyer-page-header">
    <h1>Flyer Gallery</h1>
    <p>Browse and download workshop flyers</p>
  </div>

  <!-- Card grid -->
  <div class="flyer-grid">
    {% for flyer in flyers %}
    <a class="flyer-card"
       href="#"
       data-flyer-file="/flyers/{{ flyer.file }}"
       data-flyer-title="{{ flyer.title }}"
       data-flyer-format="{{ flyer.format }}"
       onclick="openViewer(this); return false;">
      <div class="flyer-card-preview flyer-card-preview-{{ flyer.format }}">
        <iframe src="/flyers/{{ flyer.file }}" loading="lazy"
                tabindex="-1"
                {% if flyer.format == 'portrait' %}
                  width="163" height="211"
                {% else %}
                  width="288" height="162"
                {% endif %}
                scrolling="no"></iframe>
      </div>
      <div class="flyer-card-body">
        <div class="flyer-card-school">{{ flyer.school }}</div>
        <div class="flyer-card-title">{{ flyer.title }}</div>
        <div class="flyer-card-meta">
          <span class="flyer-card-date">{{ flyer.date }}</span>
          <span class="flyer-card-badge badge-{{ flyer.format }}">{{ flyer.format }}</span>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>

  <!-- Viewer overlay -->
  <div class="flyer-viewer-overlay" id="flyerViewer">
    <div class="flyer-viewer-toolbar">
      <div class="flyer-viewer-title" id="viewerTitle"></div>
      <div class="flyer-viewer-actions">
        <button class="flyer-viewer-btn flyer-viewer-btn-newtab" onclick="openInNewTab()" title="Open in new tab">
          <i class="mdi mdi-open-in-new"></i> New Tab
        </button>
        <button class="flyer-viewer-btn flyer-viewer-btn-download" onclick="downloadAsPng()" id="downloadBtn" title="Download as PNG">
          <i class="mdi mdi-download"></i> Download PNG
        </button>
        <button class="flyer-viewer-btn flyer-viewer-btn-close" onclick="closeViewer()" title="Close">
          <i class="mdi mdi-close"></i> Close
        </button>
      </div>
    </div>
    <div class="flyer-viewer-frame" id="viewerFrame"></div>
  </div>

  <!-- Footer -->
  <div class="flyer-footer">
    &copy; {{ page.date.getFullYear() }} <a href="/">MindfulOpus</a>
  </div>

  <!-- html2canvas for PNG export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <script>
    var currentFlyerFile = '';
    var currentFlyerFormat = '';
    var currentFlyerTitle = '';

    function openViewer(card) {
      currentFlyerFile = card.getAttribute('data-flyer-file');
      currentFlyerTitle = card.getAttribute('data-flyer-title');
      currentFlyerFormat = card.getAttribute('data-flyer-format');

      document.getElementById('viewerTitle').textContent = currentFlyerTitle;

      var frame = document.getElementById('viewerFrame');
      var w, h;
      if (currentFlyerFormat === 'portrait') {
        w = 816; h = 1056;
      } else {
        w = 1920; h = 1080;
      }

      // On mobile, use full available space
      var maxW = window.innerWidth - 48;
      var maxH = window.innerHeight - 100;
      var scale = Math.min(maxW / w, maxH / h, 1);
      var displayW = Math.round(w * scale);
      var displayH = Math.round(h * scale);

      frame.innerHTML = '<iframe id="viewerIframe" src="' + currentFlyerFile +
        '" width="' + displayW + '" height="' + displayH +
        '" style="border:none;background:#fff;box-shadow:0 4px 40px rgba(0,0,0,0.3);"></iframe>';

      document.getElementById('flyerViewer').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeViewer() {
      document.getElementById('flyerViewer').classList.remove('active');
      document.getElementById('viewerFrame').innerHTML = '';
      document.body.style.overflow = '';
    }

    function openInNewTab() {
      window.open(currentFlyerFile, '_blank');
    }

    function downloadAsPng() {
      var btn = document.getElementById('downloadBtn');
      btn.innerHTML = '<i class="mdi mdi-loading mdi-spin"></i> Rendering...';
      btn.disabled = true;

      var iframe = document.getElementById('viewerIframe');
      if (!iframe) {
        btn.innerHTML = '<i class="mdi mdi-download"></i> Download PNG';
        btn.disabled = false;
        return;
      }

      try {
        var iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
        var target = iframeDoc.querySelector('.flyer') || iframeDoc.querySelector('.display') || iframeDoc.body;

        html2canvas(target, {
          useCORS: true,
          allowTaint: true,
          scale: 2,
          backgroundColor: '#ffffff',
          logging: false
        }).then(function(canvas) {
          var link = document.createElement('a');
          link.download = currentFlyerTitle.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase() + '.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
          btn.innerHTML = '<i class="mdi mdi-download"></i> Download PNG';
          btn.disabled = false;
        }).catch(function(err) {
          console.error('html2canvas error:', err);
          // Fallback: open in new tab for manual screenshot
          alert('PNG export failed. Opening the flyer in a new tab — use your browser\'s screenshot feature.');
          window.open(currentFlyerFile, '_blank');
          btn.innerHTML = '<i class="mdi mdi-download"></i> Download PNG';
          btn.disabled = false;
        });
      } catch(e) {
        console.error('Cross-origin error:', e);
        // Fallback: open in new tab
        alert('PNG export failed due to cross-origin restrictions. Opening the flyer in a new tab — use your browser\'s screenshot feature.');
        window.open(currentFlyerFile, '_blank');
        btn.innerHTML = '<i class="mdi mdi-download"></i> Download PNG';
        btn.disabled = false;
      }
    }

    // Close on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeViewer();
    });

    // Close on overlay background click
    document.getElementById('flyerViewer').addEventListener('click', function(e) {
      if (e.target === this || e.target === document.getElementById('viewerFrame')) {
        closeViewer();
      }
    });
  </script>
</body>
</html>
