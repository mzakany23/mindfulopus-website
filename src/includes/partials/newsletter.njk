<!-- Start Newsletter Section -->
<section class="newsletter-section" id="newsletter">
    <!-- Subscribe Hero -->
    <div class="newsletter-hero" data-aos="fade-up">
        <div class="newsletter-hero__content">
            <span class="newsletter-hero__badge">
                <i class="mdi mdi-email-heart-outline"></i>
                Join the Community
            </span>
            <h2 class="newsletter-hero__title">Subscribe to Our Newsletter</h2>
            <p class="newsletter-hero__subtitle">
                Receive mindfulness insights, well-being practices, and behind-the-scenes stories from the classical music world — delivered to your inbox.
            </p>

            <!-- Inline Subscribe Form -->
            <div class="newsletter-form">
                <div class="newsletter-form__input-group">
                    <input
                        type="email"
                        class="newsletter-form__input"
                        placeholder="name@email.com"
                        aria-label="Email address"
                    >
                    <a href="{{ site.newsletter.subscribe }}" target="_blank" rel="noopener noreferrer" class="newsletter-form__button">
                        Subscribe Now
                        <i class="mdi mdi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <p class="newsletter-hero__privacy">
                <i class="mdi mdi-shield-check-outline"></i>
                Your information will never be shared with third parties, and you can unsubscribe at any time.
            </p>
        </div>
    </div>

    <!-- Articles Bento Grid -->
    {% if articles.articles.length > 0 %}
    <div class="newsletter-articles" data-aos="fade-up" data-aos-delay="100">
        <div class="container">
            <div class="newsletter-articles__header">
                <h3 class="newsletter-articles__title">Recent Insights</h3>
                <a href="{{ site.newsletter.medium }}" target="_blank" rel="noopener noreferrer" class="newsletter-articles__view-all">
                    View all on Medium
                    <i class="mdi mdi-arrow-right"></i>
                </a>
            </div>

            <div class="newsletter-bento" id="articles-container">
                {% for article in articles.articles %}
                {% if loop.index <= 4 %}
                <a href="{{ article.link }}" target="_blank" rel="noopener noreferrer" class="newsletter-bento__card {% if loop.index == 1 %}newsletter-bento__card--featured{% endif %}">
                    <div class="newsletter-bento__card-inner">
                        <div class="newsletter-bento__categories">
                            {% for category in article.categories %}
                            {% if loop.index <= 2 %}
                            <span class="newsletter-bento__category">{{ category }}</span>
                            {% endif %}
                            {% endfor %}
                        </div>
                        <h4 class="newsletter-bento__card-title">{{ article.title }}</h4>
                        <p class="newsletter-bento__card-excerpt">{{ article.excerpt }}</p>
                        <div class="newsletter-bento__card-footer">
                            <span class="newsletter-bento__date">{{ article.date | dateFilter }}</span>
                            <span class="newsletter-bento__read-more">
                                Read article
                                <i class="mdi mdi-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>
                {% endif %}
                {% endfor %}
            </div>

            {% if articles.articles.length > 4 %}
            <div class="newsletter-articles__more">
                <a href="{{ site.newsletter.medium }}" target="_blank" rel="noopener noreferrer" class="btn-explore-more">
                    <span>Explore More Articles</span>
                    <i class="mdi mdi-arrow-right"></i>
                </a>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</section>
<!-- End Newsletter Section -->
