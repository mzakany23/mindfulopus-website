<section class="mo-stories section" id="testimonials">
  <div class="container">
    <div class="mo-stories-head">
      <h3>Stories from the room</h3>
      <p>Musicians who’ve worked with Jo.</p>
    </div>

    <div class="testimonial-carousel mo-stories-carousel">
      <div class="carousel-dots"></div>
      <div class="carousel-container">
        <div class="testimonial-track">
          {% for testimonial in testimonials.testimonials %}
          <div class="testimonial-card mo-story">
            <div class="testimonial-content">
              <blockquote class="testimonial-text mo-story-quote">
                “{{ testimonial.quote }}”
              </blockquote>
              <div class="testimonial-author mo-story-author">
                {% if testimonial.author == "Anonymous" %}
                  <strong>{{ testimonial.role }}</strong>
                {% else %}
                  {% if testimonial.author %}<strong>{{ testimonial.author }}</strong>{% endif %}
                  {% if testimonial.role %}<span>{{ testimonial.role }}</span>{% endif %}
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      <button class="carousel-nav prev" aria-label="Previous">‹</button>
      <button class="carousel-nav next" aria-label="Next">›</button>
    </div>
  </div>
</section>
