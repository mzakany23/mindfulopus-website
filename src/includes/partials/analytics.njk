  if ({{ ph.productionHosts | dump | safe }}.indexOf(location.hostname) !== -1) {
    posthog.init('{{ ph.projectKey }}', {
      api_host: '{{ ph.apiHost }}',
      defaults: '2026-05-30',
      person_profiles: 'identified_only'
    });
  }
  // capture exists only after init, so off the production hosts this is a no-op.
  window.moTrack = function (name, props) {
    if (window.posthog && typeof posthog.capture === 'function') posthog.capture(name, props);
  };
  // Funnel steps: a Reserve click (to Stripe) and an interest-list click (to Brevo).
  document.addEventListener('click', function (event) {
    var link = event.target.closest && event.target.closest('a[href]');
    if (!link) return;
    var section = link.closest('section[id]');
    var props = { placement: section ? section.id : null, page: location.pathname };
    if (link.hostname === 'buy.stripe.com') moTrack('reserve_click', props);
