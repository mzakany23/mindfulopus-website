<section class="hero-landing" id="home">
    <!-- Floating decorative elements -->
    <div class="hero-float hero-float--1" aria-hidden="true"></div>
    <div class="hero-float hero-float--2" aria-hidden="true"></div>
    <div class="hero-float hero-float--3" aria-hidden="true"></div>

    <!-- Floating Jo portrait -->
    <a href="#me" class="hero-jo-float" data-aos="fade-left" data-aos-delay="300">
        <img src="{{ 'assets/images/headshot-full.png' }}" alt="Jo Zakany - Performance Coach">
    </a>

    <div class="container">
        <!-- Main hero content -->
        <div class="hero-content" data-aos="fade-up">
            <h1 class="hero-headline">
                Create your own mindful life,<br>
                <span class="hero-headline--accent" id="typed-headline"></span>
            </h1>

            <p class="hero-subtitle">
                Performance and well-being coaching for classical musicians who want
                to thrive—on stage and in life.
            </p>

            <div class="hero-ctas">
                <a href="#services" class="hero-btn hero-btn--primary">
                    <span>Start Your Journey</span>
                    <i class="mdi mdi-arrow-right"></i>
                </a>
                <a href="#me" class="hero-btn hero-btn--secondary">
                    <span>Meet Jo</span>
                </a>
            </div>
        </div>

        <!-- Hero action cards -->
        <div class="hero-cards" data-aos="fade-up" data-aos-delay="200">
            <!-- Card 1: Latest from Medium (Auto-carousel) -->
            <a href="{{ articles.articles[0].link }}"
               class="hero-card hero-card--1 hero-card--medium"
               target="_blank"
               rel="noopener"
               data-carousel="medium">
                <div class="hero-card__icon hero-card__icon--medium">
                    <i class="mdi mdi-alpha-m-box"></i>
                </div>
                <div class="hero-card__content">
                    <h3 class="hero-card__title">{{ articles.articles[0].title }}</h3>
                    <p class="hero-card__excerpt">{{ articles.articles[0].excerpt | truncate(80) }}</p>
                </div>
                <div class="hero-card__footer">
                    <span class="hero-card__cta hero-card__cta--medium">
                        <i class="mdi mdi-alpha-m-box"></i>
                        Read on Medium
                    </span>
                    <div class="hero-card__dots"></div>
                </div>
            </a>

            <!-- Card 2: Work With Me (Calendly) - Static -->
            <a href="https://calendly.com/mindfulopus/30min" class="hero-card hero-card--2 hero-card--calendly" target="_blank" rel="noopener">
                <div class="hero-card__icon hero-card__icon--calendly">
                    <i class="mdi mdi-calendar-check"></i>
                </div>
                <h3 class="hero-card__title">Work With Me</h3>
                <p class="hero-card__excerpt">Book a free 30-minute consultation to start your journey.</p>
                <span class="hero-card__btn hero-card__btn--calendly">
                    <i class="mdi mdi-calendar-clock"></i>
                    Schedule on Calendly
                </span>
            </a>

            <!-- Card 3: Podcast (Auto-carousel) -->
            {# Filter out trailer for carousel #}
            {% set regularEpisodes = [] %}
            {% for ep in episodes.episodes %}
                {% if not ep.isTrailer %}
                    {% set regularEpisodes = (regularEpisodes.push(ep), regularEpisodes) %}
                {% endif %}
            {% endfor %}
            <a href="#podcast"
               class="hero-card hero-card--3 hero-card--podcast"
               data-carousel="podcast">
                <div class="hero-card__icon hero-card__icon--platforms">
                    <i class="mdi mdi-youtube icon--youtube"></i>
                    <i class="mdi mdi-apple icon--apple"></i>
                    <i class="mdi mdi-spotify icon--spotify"></i>
                </div>
                <div class="hero-card__content">
                    <h3 class="hero-card__title">{{ regularEpisodes[0].title }}</h3>
                    <p class="hero-card__excerpt">{{ regularEpisodes[0].description | truncate(80) }}</p>
                </div>
                <div class="hero-card__footer">
                    <span class="hero-card__cta">Listen Now →</span>
                    <div class="hero-card__dots"></div>
                </div>
            </a>
        </div>
    </div>

    <!-- Carousel data for JavaScript -->
    <script id="hero-carousel-data" type="application/json">
    {
        "medium": {{ articles.articles | dump | safe }},
        "podcast": {{ regularEpisodes | dump | safe }}
    }
    </script>
</section>
