<!-- Start Podcast Section -->
<section class="section podcast-section" id="podcast">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h3>{{ podcast.name }}</h3>
                <p class="text-muted mt-3">{{ podcast.tagline }}</p>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="col-lg-5 col-md-5 mb-4 mb-lg-0">
                <div class="podcast-video-wrapper">
                    <div class="podcast-video">
                        <iframe
                            src="https://www.youtube.com/embed/n74KezrDJ_A"
                            title="{{ podcast.name }} Trailer"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen>
                        </iframe>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 col-md-7">
                <div class="podcast-content">
                    <h4 class="mb-4">About the Podcast</h4>
                    <p class="podcast-description">{{ podcast.description }}</p>

                    <div class="podcast-host mt-4">
                        <h5>Hosted by {{ podcast.host.name }}</h5>
                        <p class="text-muted">{{ podcast.host.bio }}</p>
                    </div>

                    <div class="podcast-listen-buttons mt-4">
                        <h5 class="mb-3">Listen Now</h5>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="{{ site.podcast.spotify }}" target="_blank" rel="noopener noreferrer" class="btn btn-podcast btn-spotify">
                                <i class="mdi mdi-spotify"></i>
                                Spotify
                            </a>
                            <a href="{{ site.podcast.youtube }}" target="_blank" rel="noopener noreferrer" class="btn btn-podcast btn-youtube">
                                <i class="mdi mdi-youtube"></i>
                                YouTube
                            </a>
                            <a href="{{ site.podcast.applePodcast }}" target="_blank" rel="noopener noreferrer" class="btn btn-podcast btn-apple">
                                <i class="mdi mdi-podcast"></i>
                                Apple Podcasts
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-5 pt-4">
            <div class="col-lg-10">
                <h4 class="mb-4">Recent Episodes</h4>
                <ul class="stack-list" id="episodes-container">
                    {% for episode in episodes.episodes %}
                    <li class="stack-item episode-item{% if loop.index > 6 %} episode-paginated episode-hidden{% endif %}">
                        <div class="stack-meta">
                            <span class="stack-meta-strong">{% if episode.isTrailer %}Trailer{% else %}Episode {{ episode.episodeNumber }}{% endif %}</span>
                            <span>{{ episode.duration }}</span>
                            <span>{{ episode.date | dateFilter }}</span>
                        </div>
                        <h5 class="stack-title">{{ episode.title }}</h5>
                        <p class="stack-excerpt">{{ episode.description }}</p>
                        <div class="stack-actions">
                            <a href="{{ episode.links.spotify }}" target="_blank" rel="noopener noreferrer" class="stack-platform">Spotify</a>
                            <a href="{{ episode.links.youtube }}" target="_blank" rel="noopener noreferrer" class="stack-platform">YouTube</a>
                            <a href="{{ episode.links.applePodcast }}" target="_blank" rel="noopener noreferrer" class="stack-platform">Apple Podcasts</a>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% if episodes.episodes.length > 6 %}
                <div class="text-center mt-4">
                    <button class="btn btn-outline-secondary btn-show-more" id="show-more-episodes" onclick="toggleEpisodes()">
                        <span class="show-more-text">Show More Episodes</span>
                        <span class="show-less-text" style="display: none;">Show Less</span>
                        <i class="mdi mdi-chevron-down show-more-icon"></i>
                        <i class="mdi mdi-chevron-up show-less-icon" style="display: none;"></i>
                    </button>
                </div>
                <script>
                    function toggleEpisodes() {
                        const paginatedEpisodes = document.querySelectorAll('.episode-paginated');
                        const btn = document.getElementById('show-more-episodes');
                        const isExpanded = btn.classList.contains('expanded');

                        paginatedEpisodes.forEach(ep => {
                            if (isExpanded) {
                                ep.classList.add('episode-hidden');
                            } else {
                                ep.classList.remove('episode-hidden');
                            }
                        });

                        btn.classList.toggle('expanded');

                        const showMoreText = btn.querySelector('.show-more-text');
                        const showLessText = btn.querySelector('.show-less-text');
                        const showMoreIcon = btn.querySelector('.show-more-icon');
                        const showLessIcon = btn.querySelector('.show-less-icon');

                        if (isExpanded) {
                            showMoreText.style.display = '';
                            showLessText.style.display = 'none';
                            showMoreIcon.style.display = '';
                            showLessIcon.style.display = 'none';
                        } else {
                            showMoreText.style.display = 'none';
                            showLessText.style.display = '';
                            showMoreIcon.style.display = 'none';
                            showLessIcon.style.display = '';
                        }
                    }
                </script>
                {% endif %}
            </div>
        </div>
    </div>
</section>
<!-- End Podcast Section -->
