{
  "name": "mindfulopus-website",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "run:dev": "cross-env ELEVENTY_ENV=development npx @11ty/eleventy --serve",
    "build:eleventy": "cross-env ELEVENTY_ENV=production npx @11ty/eleventy",
    "watch:sass": "sass --watch src/assets/styles:dist/assets/styles",
    "build:sass": "sass src/assets/styles:dist/assets/styles",
    "build:app": "run-p build:sass build:eleventy",
    "install:app": "rm -rf dist & npm install",
    "develop": "run-p watch:sass run:dev",
    "build": "npm install npm-run-all && run-s install:app build:app"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "@11ty/eleventy": "^0.12.1",
    "@11ty/eleventy-plugin-rss": "^1.1.1",
    "clean-css": "^5.1.5",
    "cross-env": "^7.0.3",
    "eleventy-plugin-svg-sprite": "^1.2.1",
    "html-minifier": "^4.0.0",
    "luxon": "^1.28.0",
    "node-sass": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.49.7"
  }
}
