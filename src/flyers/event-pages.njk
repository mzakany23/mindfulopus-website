---
pagination:
  data: flyerEvents
  size: 1
  alias: event
permalink: "/flyers/{{ event.schoolSlug }}/{{ event.slug }}/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ event.title }} — {{ event.schoolShort }} — MindfulOpus</title>
  <meta name="description" content="{{ event.summary }}">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/vendor/css/materialdesignicons.min.css" type="text/css">
  {% include "partials/flyer-chrome-styles.njk" %}
</head>
<body>
  {% set schoolUrl = event.schoolUrl %}
  {% set schoolShort = event.schoolShort %}
  {% include "partials/flyer-topbar.njk" %}

  <main class="flyer-page">
    <p class="flyer-breadcrumb">
      <a href="/flyers/">Workshops &amp; Events</a>
      <span>/</span>
      <a href="{{ event.schoolUrl }}">{{ event.schoolShort }}</a>
      <span>/</span>
      {{ event.title }}
    </p>

    <header class="flyer-page-header">
      <p class="eyebrow">{{ event.series }}{% if event.part %} · {{ event.part }}{% endif %}</p>
      <h1>{{ event.title }}</h1>
    </header>

    <div class="event-meta-row">
      <span><strong>Date</strong> {{ event.dateLabel }}</span>
      <span><strong>Location</strong> {{ event.schoolName }}</span>
      <span><strong>Status</strong> {{ event.status | capitalize }}</span>
    </div>

    {% if event.summary %}
    <p class="event-summary">{{ event.summary }}</p>
    {% endif %}

    {% if event.flyers.length > 1 %}
    <div class="flyer-variants" role="tablist" aria-label="Flyer versions">
      {% for flyer in event.flyers %}
      <button type="button"
              class="flyer-variant{% if flyer.primary %} active{% endif %}"
              data-file="/flyers/{{ flyer.file }}"
              data-format="{{ flyer.format }}"
              data-label="{{ flyer.label }}"
              onclick="showFlyer(this)">
        {{ flyer.label }}
      </button>
      {% endfor %}
    </div>
    {% endif %}

    <div class="flyer-preview-shell" id="flyerPreview">
      {% set primary = event.primaryFlyer %}
      <iframe id="flyerFrame"
              src="/flyers/{{ primary.file }}"
              title="{{ event.title }} flyer"
              {% if primary.format == 'portrait' %}
                width="408" height="528"
              {% else %}
                width="960" height="540"
              {% endif %}
              loading="lazy"></iframe>
    </div>

    <div class="flyer-actions">
      <a class="flyer-action-btn flyer-action-btn-primary" id="openFull" href="/flyers/{{ primary.file }}" target="_blank" rel="noopener">
        <i class="mdi mdi-open-in-new"></i> Open full size
      </a>
      <a class="flyer-action-btn flyer-action-btn-secondary" href="{{ event.schoolUrl }}">
        <i class="mdi mdi-arrow-left"></i> All {{ event.schoolShort }} events
      </a>
    </div>
  </main>

  <div class="flyer-footer">
    &copy; {{ page.date.getFullYear() }} <a href="/">MindfulOpus</a>
  </div>

  <script>
    function showFlyer(btn) {
      var file = btn.getAttribute('data-file');
      var format = btn.getAttribute('data-format');
      var frame = document.getElementById('flyerFrame');
      var openFull = document.getElementById('openFull');

      document.querySelectorAll('.flyer-variant').forEach(function (el) {
        el.classList.toggle('active', el === btn);
      });

      frame.src = file;
      if (format === 'portrait') {
        frame.width = 408;
        frame.height = 528;
      } else {
        frame.width = 960;
        frame.height = 540;
      }
      openFull.href = file;
    }
  </script>
</body>
</html>
