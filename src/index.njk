                <div class="stack-meta">
                  {% if episode._n == 1 %}<strong>Latest</strong>{% endif %}
                  <strong>
                    {% if episode.isTrailer %}Trailer
                    {% elif episode.isBonus %}Bonus
                    {% else %}S{{ episode.season }} · Ep {{ episode.episodeNumber }}{% endif %}
                  </strong>
                  {% if episode.duration and episode.duration != "TBD" %}<span>{{ episode.duration }}</span>{% endif %}
                  <span>{{ episode.date | dateFilter }}</span>
                  {% if episode.views %}<span>{{ episode.views }} views</span>{% endif %}
