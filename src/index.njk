      background: linear-gradient(
        180deg,
        #1a4f4b 0%,
        rgba(26,79,75,0.88) 16%,
        rgba(26,79,75,0.4) 40%,
        rgba(244,247,245,0.5) 70%,
        var(--foam) 100%
      );
