    /* Seamless section bridges — pure gradient, no blur band / hard edge */
    .bridge {
      height: clamp(7rem, 15vw, 12rem);
      pointer-events: none;
      margin: 0;
      border: 0;
      position: relative;
      overflow: hidden;
