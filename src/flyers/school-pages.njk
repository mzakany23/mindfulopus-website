---
pagination:
  data: flyerSchools
  size: 1
  alias: school
permalink: "/flyers/{{ school.slug }}/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ school.name }} Workshops — MindfulOpus</title>
  <meta name="description" content="MindfulOpus workshops and performance series at {{ school.name }}.">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/vendor/css/materialdesignicons.min.css" type="text/css">
  {% include "partials/flyer-chrome-styles.njk" %}
</head>
<body>
  {% set schoolUrl = "/flyers/" %}
  {% set schoolShort = "schools" %}
  {% include "partials/flyer-topbar.njk" %}

  <main class="flyer-page">
    <p class="flyer-breadcrumb">
      <a href="/flyers/">Workshops &amp; Events</a>
      <span>/</span>
      {{ school.shortName }}
    </p>

    <header class="flyer-page-header">
      <p class="eyebrow">{{ school.name }}</p>
      <h1>{{ school.shortName }} workshops</h1>
      <p class="lede">Every MindfulOpus session at {{ school.shortName }} — share a link to any event below.</p>
    </header>

    <section class="flyer-section" aria-labelledby="upcoming-heading">
      <h2 class="flyer-section-title" id="upcoming-heading">Upcoming</h2>
      {% if school.upcomingCount %}
      <ul class="flyer-list">
        {% for event in school.upcoming %}
        <li class="flyer-list-item">
          <a href="{{ event.url }}">
            <div class="flyer-list-date">{{ event.dateLabel }}</div>
            <div class="flyer-list-copy">
              <p class="series">{{ event.series }}{% if event.part %} · {{ event.part }}{% endif %}</p>
              <p class="title">{{ event.title }}</p>
            </div>
            <span class="flyer-list-arrow" aria-hidden="true"><i class="mdi mdi-chevron-right"></i></span>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="empty-note">No upcoming sessions scheduled right now.</p>
      {% endif %}
    </section>

    <section class="flyer-section" aria-labelledby="past-heading">
      <h2 class="flyer-section-title" id="past-heading">Past events</h2>
      {% if school.pastCount %}
      <ul class="flyer-list">
        {% for event in school.past %}
        <li class="flyer-list-item">
          <a href="{{ event.url }}">
            <div class="flyer-list-date">{{ event.dateLabel }}</div>
            <div class="flyer-list-copy">
              <p class="series">{{ event.series }}{% if event.part %} · {{ event.part }}{% endif %}</p>
              <p class="title">{{ event.title }}</p>
            </div>
            <span class="flyer-list-arrow" aria-hidden="true"><i class="mdi mdi-chevron-right"></i></span>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="empty-note">No past events yet.</p>
      {% endif %}
    </section>
  </main>

  <div class="flyer-footer">
    &copy; {{ page.date.getFullYear() }} <a href="/">MindfulOpus</a>
  </div>
</body>
</html>
