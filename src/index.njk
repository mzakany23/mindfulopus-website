    /* Content rises into view; section shells stay fully opaque (no white flash) */
    .reveal .anim {
      opacity: 0;
      transform: translate3d(0, 2.75rem, 0);
      filter: blur(8px);
      transition:
        opacity 950ms var(--ease),
        transform 950ms var(--ease),
        filter 950ms var(--ease);
      will-change: opacity, transform, filter;
    }
    .reveal.is-in .anim {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
    .reveal.is-in .anim-d1 { transition-delay: 90ms; }
    .reveal.is-in .anim-d2 { transition-delay: 180ms; }
    .reveal.is-in .anim-d3 { transition-delay: 270ms; }
    .reveal.is-in .anim-d4 { transition-delay: 360ms; }
    .reveal.is-in .anim-d5 { transition-delay: 450ms; }
    .reveal.is-in .anim-d6 { transition-delay: 540ms; }
    .reveal.is-in .anim-d7 { transition-delay: 630ms; }
    .photo-strip.reveal figure {
      opacity: 0;
      transform: translate3d(0, 2rem, 0);
      filter: blur(6px);
      transition: opacity 900ms var(--ease), transform 900ms var(--ease), filter 900ms var(--ease);
    }
    .photo-strip.reveal.is-in figure {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
    .photo-strip.reveal.is-in figure:nth-child(1) { transition-delay: 60ms; }
    .photo-strip.reveal.is-in figure:nth-child(2) { transition-delay: 160ms; }
    .photo-strip.reveal.is-in figure:nth-child(3) { transition-delay: 260ms; }
    @media (prefers-reduced-motion: reduce) {
      .reveal .anim,
      .photo-strip.reveal figure {
        opacity: 1;
        transform: none;
        filter: none;
        transition: none;
      }
      .nav-links a::after,
      .platform, .btn, .offer-go, .podcast .btn-show-more {
        transition: none !important;
      }
      .platform:hover, .btn:hover, .offer:hover .offer-go, .podcast .btn-show-more:hover {
        transform: none !important;
        box-shadow: none !important;
      }
    }

