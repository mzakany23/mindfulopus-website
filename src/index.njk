permalink: /
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MindfulOpus — Performance & Well-Being Coaching for Classical Musicians</title>
  <meta name="description" content="Performance and well-being coaching for classical musicians. 1:1 coaching, StudentOpus, podcast, and newsletter with Jo Zakany." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet" />
  <link rel="icon" href="/assets/images/favicon.ico" />
  <style>
    :root {
      --ink: #101816;
      --ink-soft: #24332f;
      --muted: #4a5a55;
      --teal: #2a7d7d;
      --teal-deep: #1f6666;
      --sage: #8f9c92;
      --foam: #f4f7f5;
      --ember: #c45c4a;
      --ember-deep: #a84838;
      --paper: #ffffff;
      --line: rgba(16, 24, 22, 0.07);
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --max: 1080px;
      --display: "Source Serif 4", "Iowan Old Style", Georgia, serif;
      --sans: "Source Sans 3", "Source Sans Pro", system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
    body {
      margin: 0;
      font-family: var(--sans);
      font-size: 1.125rem;
      line-height: 1.65;
      color: var(--ink);
      background:
        radial-gradient(1200px 600px at 10% -10%, rgba(181, 191, 182, 0.35), transparent 60%),
        radial-gradient(900px 500px at 100% 20%, rgba(42, 125, 125, 0.08), transparent 55%),
        var(--foam);
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; display: block; }
    /* Soft paper grain — last-mile texture without heavy assets */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 50;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 180px 180px;
      mix-blend-mode: multiply;
    }
    .podcast {
      isolation: isolate;
    }
    .podcast::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      opacity: 0.07;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 160px 160px;
      mix-blend-mode: soft-light;
    }
    .podcast > .wrap { position: relative; z-index: 1; }
    a { color: inherit; }
    ::selection {
      background: rgba(42, 125, 125, 0.28);
      color: var(--ink);
    }
    .podcast ::selection,
    .band ::selection {
      background: rgba(196, 92, 74, 0.45);
      color: #fff;
    }
    .wrap {
      width: min(var(--max), calc(100% - 2.75rem));
      margin-inline: auto;
    }

    /* —— Nav —— */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(255,255,255,0.94);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid transparent;
      transition: border-color 240ms var(--ease), background 240ms var(--ease), box-shadow 240ms var(--ease);
    }
    .nav.is-scrolled {
      border-bottom-color: var(--line);
      background: rgba(255,255,255,0.97);
      box-shadow: 0 8px 28px rgba(16, 24, 22, 0.06);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.05rem 0;
    }
    .nav-brand img { height: 52px; width: auto; }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 0 1.65rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav-links a {
      position: relative;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-soft);
      padding-bottom: 0.2rem;
      border-bottom: none;
    }
    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 1.5px;
      background: var(--teal);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 280ms var(--ease);
    }
    .nav-links a:hover { color: var(--teal-deep); }
    .nav-links a:hover::after { transform: scaleX(0.55); opacity: 0.55; }
    .nav-links a.is-active {
      color: var(--teal-deep);
    }
    .nav-links a.is-active::after {
      transform: scaleX(1);
      opacity: 1;
    }
    .nav-cta {
      color: var(--teal-deep) !important;
    }
    .nav-toggle {
      display: none;
      border: 0;
      background: transparent;
      font-size: 1.35rem;
      line-height: 1;
      color: var(--ink);
      cursor: pointer;
      padding: 0.25rem;
    }
    @media (max-width: 820px) {
      .nav-toggle { display: block; }
      .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0; right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: #fff;
        border-bottom: 1px solid var(--line);
        padding: 0.5rem 1.25rem 1rem;
      }
      .nav-links.is-open { display: flex; }
      .nav-links a { padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
      .nav-links a { border-bottom: 1px solid var(--line); }
      .nav-links a.is-active { border-bottom-color: var(--teal); }
    }

    /* —— Hero (Jillian craft: photo + serif display) —— */
    .hero {
      position: relative;
      min-height: 100svh;
      display: grid;
      place-items: end center;
      overflow: hidden;
      color: #fff;
      text-align: center;
    }
    .hero-media {
      position: absolute;
      inset: 0;
      will-change: transform;
    }
    .hero-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Face is mid-frame; low % showed only ceiling / top of head on wide desktops */
      object-position: 48% 56%;
    }
    @media (max-width: 900px) {
      .hero-media img { object-position: 46% 48%; }
    }
    @media (min-width: 1200px) {
      .hero-media img { object-position: 47% 58%; }
    }
    .hero-veil {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(16,24,22,0.12) 0%, rgba(16,24,22,0.28) 45%, rgba(16,24,22,0.78) 100%);
    }
    .hero-copy {
      position: relative;
      z-index: 1;
      width: min(44rem, calc(100% - 2.5rem));
      padding: 0 0 clamp(4.5rem, 12vh, 7rem);
      opacity: 0;
      transform: translateY(1.25rem);
      transition: opacity 900ms var(--ease), transform 900ms var(--ease);
      will-change: opacity, transform;
    }
    .hero.is-ready .hero-copy {
      opacity: 1;
      transform: none;
    }
    .hero h1 {
      margin: 0 0 1rem;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(2.35rem, 5.6vw, 4.15rem);
      line-height: 1.12;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }
    .hero h1 em {
      font-style: italic;
      font-weight: 400;
    }
    .hero-lede {
      margin: 0 0 1.75rem;
      font-size: clamp(0.72rem, 1.1vw, 0.82rem);
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.88);
    }
    .hero-link {
      display: inline-block;
      color: #fff;
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border-bottom: 1.5px solid rgba(255,255,255,0.85);
      padding-bottom: 0.2rem;
    }
    .hero-link:hover { border-bottom-color: #fff; }

    /* —— Sections rhythm (tight, not sparse) —— */
    section { padding: clamp(3.25rem, 7vw, 5rem) 0; }
    .section-title {
      margin: 0 0 0.4rem;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(2rem, 3.8vw, 2.85rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .section-lede {
      margin: 0 0 1.75rem;
      color: var(--muted);
      font-size: 1.15rem;
      max-width: 38rem;
      line-height: 1.55;
    }
    .brand-heading {
      display: flex;
      align-items: center;
      gap: 0.55rem 0.75rem;
      flex-wrap: wrap;
    }
    .brand-heading .brand-mark {
      height: clamp(1.7rem, 3.1vw, 2.35rem);
      width: auto;
      display: block;
    }
    .brand-heading .brand-suffix {
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(1.7rem, 3.1vw, 2.35rem);
      letter-spacing: -0.02em;
      color: var(--ink);
      line-height: 1;
    }
    .name-opus {
      color: var(--teal);
    }
    .btn .name-opus {
      color: #d7f0ec;
    }
    .podcast .name-opus,
    .nav-links .name-opus {
      color: #8fd0c8;
    }
    .brand-inline {
      display: inline-block;
      height: 1.15em;
      width: auto;
      vertical-align: -0.22em;
      margin: 0 0.12em;
    }

    /* —— About —— */
    .about { background: var(--paper); }
    .about-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(1.75rem, 4.5vw, 3.5rem);
      align-items: center;
    }
    .about-photo {
      margin: 0;
      overflow: hidden;
      aspect-ratio: 4 / 5;
    }
    .about-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 12%;
    }
    .about-hello {
      margin: 0 0 0.35rem;
      font-family: var(--display);
      font-style: italic;
      font-size: 1.35rem;
      color: var(--teal-deep);
    }
    .about h2 {
      margin: 0 0 1rem;
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      letter-spacing: -0.02em;
    }
    .about p {
      margin: 0 0 0.85rem;
      color: var(--ink-soft);
      max-width: none;
    }
    .about-copy { max-width: 40rem; }
    .about p:last-child { margin-bottom: 0; }
    @media (max-width: 800px) {
      .about-grid { grid-template-columns: 1fr; }
      .about-photo {
        max-width: 18rem;
        aspect-ratio: 3 / 4;
      }
    }

    /* —— Mission pull-quote —— */
    .mission {
      background: var(--foam);
      text-align: center;
      padding-block: clamp(2.75rem, 6vw, 4rem);
    }
    .mission blockquote {
      margin: 0 auto;
      max-width: 28rem;
      font-family: var(--display);
      font-style: italic;
      font-size: clamp(1.45rem, 2.8vw, 1.95rem);
      line-height: 1.35;
      letter-spacing: -0.015em;
      color: var(--teal-deep);
      font-weight: 400;
    }

    /* —— Offerings: clean editorial rows —— */
    .offerings { background: var(--paper); }
    .offer-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: clamp(1.75rem, 4vw, 3.25rem);
      align-items: start;
    }
    .offer-photo {
      margin: 0;
      position: sticky;
      top: 5.75rem;
      overflow: hidden;
      aspect-ratio: 3 / 4;
    }
    .offer-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .offer-list { border-top: 1px solid var(--line); }
    .offer {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1.5rem;
      align-items: baseline;
      padding: 1.35rem 0 1.4rem;
      border-bottom: 1px solid var(--line);
    }
    .offer h3 {
      margin: 0 0 0.35rem;
      font-family: var(--display);
      font-size: clamp(1.35rem, 2.2vw, 1.6rem);
      font-weight: 600;
      letter-spacing: -0.015em;
    }
    .offer h3 a {
      text-decoration: none;
      color: inherit;
    }
    .offer h3 a:hover { color: var(--teal-deep); }
    .offer p {
      margin: 0;
      color: var(--muted);
      font-size: 1.05rem;
      max-width: 38ch;
      line-height: 1.5;
    }
    .offer-go {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--teal-deep);
      text-decoration: none;
      white-space: nowrap;
      align-self: start;
      padding-top: 0.2rem;
    }
    .offer-go span {
      display: inline-block;
      margin-left: 0.35rem;
      transition: transform 180ms var(--ease);
    }
    .offer-go {
      transition: color 160ms var(--ease), transform 180ms var(--ease);
    }
    .offer:hover .offer-go { transform: translateY(-1px); }
    .offer:hover .offer-go span { transform: translateX(3px); }
    @media (max-width: 800px) {
      .offer-layout { grid-template-columns: 1fr; }
      .offer-photo { position: static; max-height: 280px; aspect-ratio: 16 / 10; }
      .offer { grid-template-columns: 1fr; gap: 0.45rem; }
      .offer-go { padding-top: 0; }
    }


    /* —— How I work (coaching story, not a product index) —— */
    .work { background: var(--paper); }
    .work-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(1.75rem, 4vw, 3.25rem);
      align-items: start;
    }
    .work-photo {
      margin: 0;
      position: sticky;
      top: 5.75rem;
      overflow: hidden;
      aspect-ratio: 3 / 4;
    }
    .work-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .work-copy .section-lede { margin-bottom: 1.1rem; }
    .work-copy > p {
      margin: 0 0 1rem;
      color: var(--ink-soft);
      font-size: 1.08rem;
      max-width: 42rem;
    }
    .work-sub {
      margin: 1.5rem 0 0.65rem;
      font-family: var(--display);
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--teal-deep);
    }
    .work-list {
      margin: 0 0 1.5rem;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.55rem;
      max-width: 40rem;
    }
    .work-list li {
      position: relative;
      padding-left: 1.15rem;
      color: var(--ink-soft);
      font-size: 1.05rem;
      line-height: 1.45;
    }
    .work-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 999px;
      background: var(--teal);
    }
    .work .offer-go {
      display: inline-flex;
      font-size: 1.05rem;
    }
    @media (max-width: 800px) {
      .work-grid { grid-template-columns: 1fr; }
      .work-photo { position: static; max-height: 280px; aspect-ratio: 16 / 10; }
    }

    /* —— StudentOpus band —— */
    .studentopus-band {
      background: var(--foam);
      position: relative;
      overflow: hidden;
    }
    .studentopus-band .wrap {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: center;
    }
    .studentopus-band h2 {
      margin: 0 0 0.55rem;
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(2rem, 3.6vw, 2.75rem);
      letter-spacing: -0.02em;
    }
    .studentopus-band h2 .name-opus { color: var(--teal); }
    .studentopus-band p {
      margin: 0 0 1.25rem;
      color: var(--ink-soft);
      font-size: 1.12rem;
      max-width: 36ch;
    }
    .studentopus-photo {
      margin: 0;
      overflow: hidden;
      aspect-ratio: 4 / 5;
    }
    .studentopus-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 18%;
    }
    @media (max-width: 800px) {
      .studentopus-band .wrap { grid-template-columns: 1fr; }
      .studentopus-photo { max-width: 20rem; aspect-ratio: 3 / 4; }
    }

    /* —— Stories: infinite slow marquee —— */
    .stories {
      background: var(--foam);
      overflow: hidden;
    }
    .stories .section-lede { margin-bottom: 1.25rem; }
    .stories .wrap { margin-bottom: 0.35rem; }
    .story-marquee {
      overflow: hidden;
      mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    }
    .story-track {
      display: flex;
      gap: 1rem;
      width: max-content;
      animation: story-scroll 70s linear infinite;
      padding-inline: 1rem;
    }
    .story-marquee:hover .story-track { animation-play-state: paused; }
    @keyframes story-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .story {
      flex: 0 0 min(320px, 78vw);
      background: var(--paper);
      padding: 1.35rem 1.25rem 1.25rem;
    }
    .story blockquote {
      margin: 0 0 1rem;
      font-family: var(--display);
      font-size: 1.15rem;
      line-height: 1.4;
      letter-spacing: -0.01em;
      font-weight: 400;
    }
    .story cite {
      font-style: normal;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--teal-deep);
    }
    .story cite span {
      display: block;
      margin-top: 0.2rem;
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* —— Podcast —— */
    .podcast-top {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
      gap: clamp(1.5rem, 3.5vw, 2.75rem);
      align-items: start;
      margin-bottom: 2.5rem;
    }
    .podcast-about {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      min-width: 0; /* prevent text bleed into right column */
      max-width: 34rem;
    }
    .podcast-about .section-title {
      margin-bottom: 0;
    }
    .podcast-about .section-lede {
      margin: 0;
      max-width: 100%;
      color: rgba(244,247,245,0.78);
      font-size: 1.05rem;
    }
    .podcast-about .platform-row { margin-top: 0.55rem; }
    .podcast-blurb {
      margin: 0.35rem 0 0;
      color: rgba(244,247,245,0.92);
      max-width: 100%;
      font-size: clamp(1.15rem, 2vw, 1.32rem);
      line-height: 1.45;
      font-family: var(--display);
      font-weight: 400;
      letter-spacing: -0.01em;
    }
    .podcast-host-line {
      margin: 0;
      color: rgba(244,247,245,0.72);
      max-width: none;
      font-size: 1.02rem;
    }
    .podcast-features {
      list-style: none;
      margin: 0 0 1.35rem;
      padding: 0;
      display: grid;
      gap: 0.55rem;
    }
    .podcast-features li {
      position: relative;
      padding-left: 1.1rem;
      color: rgba(244,247,245,0.9);
      font-size: 1.02rem;
    }
    .podcast-features li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 999px;
      background: #8fd0c8;
    }
    .podcast-cover {
      margin: 0 0 1.25rem;
      width: min(11.5rem, 55%);
      border: 1px solid rgba(255,255,255,0.12);
      box-shadow: 0 18px 40px rgba(0,0,0,0.28);
      overflow: hidden;
    }
    .podcast-cover img { width: 100%; height: auto; display: block; }
    .podcast-latest-label {
      margin: 0 0 0.55rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--teal-deep);
    }
    .podcast-latest {
      display: block;
      text-decoration: none;
      color: inherit;
      border: 1px solid rgba(255,255,255,0.24);
      background: rgba(255,255,255,0.12);
      overflow: hidden;
      border-radius: 1.4rem;
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: transform 220ms var(--ease), box-shadow 220ms var(--ease), border-color 220ms var(--ease);
    }
    .podcast-latest:hover {
      border-color: rgba(143, 208, 200, 0.6);
      transform: translateY(-5px);
