  <script>
    (function () {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var toggle = document.getElementById("nav-toggle");
      var links = document.getElementById("nav-links");
      var nav = document.getElementById("site-nav");
      var hero = document.getElementById("hero");

      if (toggle && links) {
        toggle.addEventListener("click", function () {
          var open = links.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        });
      }

      if (hero) {
        requestAnimationFrame(function () {
          hero.classList.add("is-ready");
        });
      }

      function syncGroupVisibility(groupSelector, itemSelector) {
        document.querySelectorAll(groupSelector).forEach(function (block) {
          var items = block.querySelectorAll(itemSelector);
          var any = false;
          for (var i = 0; i < items.length; i++) {
            if (!items[i].classList.contains("is-hidden")) { any = true; break; }
          }
          block.style.display = any ? "" : "none";
        });
      }

      function wireShowMore(btnId, itemSelector, moreLabel, lessLabel, after) {
        var btn = document.getElementById(btnId);
        if (!btn) return;
        btn.addEventListener("click", function () {
          var expanded = btn.getAttribute("data-expanded") === "true";
          document.querySelectorAll(itemSelector).forEach(function (el) {
            el.classList.toggle("is-hidden", expanded);
          });
          btn.setAttribute("data-expanded", expanded ? "false" : "true");
          btn.textContent = expanded ? moreLabel : lessLabel;
          if (after) after();
        });
      }

      function syncEpisodes() { syncGroupVisibility(".season-block", ".episode"); }
      function syncArticles() { syncGroupVisibility(".article-year", ".article"); }

      wireShowMore("show-more-episodes", ".episode-paginated", "Show more episodes", "Show fewer episodes", syncEpisodes);
      wireShowMore("show-more-articles", ".article-paginated", "Show more articles", "Show fewer articles", syncArticles);
      syncEpisodes();
      syncArticles();

      var toast = document.getElementById("nl-toast");
      var toastClose = document.getElementById("nl-toast-close");
      var toastKey = "mo-nl-toast-dismissed";
      var toastShown = false;
      function openToast() {
        if (!toast || toastShown) return;
        if (window.sessionStorage && sessionStorage.getItem(toastKey) === "1") return;
        toastShown = true;
        toast.classList.add("is-open");
        toast.setAttribute("aria-hidden", "false");
      }
      function closeToast() {
        if (!toast) return;
        toast.classList.remove("is-open");
        toast.setAttribute("aria-hidden", "true");
        try { sessionStorage.setItem(toastKey, "1"); } catch (e) {}
      }
      if (toastClose) toastClose.addEventListener("click", closeToast);
      if (toast) {
        toast.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", closeToast);
        });
      }

      var layers = document.querySelectorAll("[data-parallax]");
      var deepLayers = document.querySelectorAll("[data-parallax-deep] img");
      var ticking = false;

      var reveals = Array.prototype.slice.call(document.querySelectorAll(".reveal"));
      function revealInView() {
        var vh = window.innerHeight || 800;
        reveals.forEach(function (el) {
          if (el.classList.contains("is-in")) return;
          var rect = el.getBoundingClientRect();
          // Fire when ~18% of the section has entered the lower viewport
          var visible = Math.min(rect.bottom, vh) - Math.max(rect.top, 0);
          if (visible > Math.min(rect.height * 0.18, vh * 0.18) && rect.top < vh * 0.92) {
            el.classList.add("is-in");
          }
        });
      }
      if (!reduce) {
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.12) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          }, { threshold: [0, 0.12, 0.2, 0.35], rootMargin: "0px 0px -8% 0px" });
          reveals.forEach(function (el) { io.observe(el); });
        }
        // Do NOT pre-mark below-fold sections on load — wait for scroll
        revealInView();
      } else {
        reveals.forEach(function (el) { el.classList.add("is-in"); });
      }

      var spyIds = ["about", "offerings", "studentopus", "podcast", "newsletter", "contact"];
      var spyLinks = {};
      if (links) {
        links.querySelectorAll("a[href^='#']").forEach(function (a) {
          var id = a.getAttribute("href").slice(1);
          if (id) spyLinks[id] = a;
        });
      }
      var heroCopy = document.querySelector(".hero-copy");

      function onScroll() {
        var y = window.scrollY || 0;
        if (nav) nav.classList.toggle("is-scrolled", y > 12);
        if (y > window.innerHeight * 1.15) openToast();

        if (heroCopy && !reduce) {
          var fade = Math.max(0, 1 - y / (window.innerHeight * 0.7));
          heroCopy.style.opacity = String(fade);
          heroCopy.style.transform = "translateY(" + ((1 - fade) * 28) + "px)";
        }

        var active = null;
        var marker = (nav ? nav.offsetHeight : 72) + 20;
        spyIds.forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          var rect = el.getBoundingClientRect();
          // Active = section that currently owns the marker line
          if (rect.top <= marker && rect.bottom > marker + 60) active = id;
        });
        // Near bottom of page, prefer contact
        if ((window.innerHeight + y) >= (document.documentElement.scrollHeight - 80)) {
          active = "contact";
        }
        Object.keys(spyLinks).forEach(function (id) {
          spyLinks[id].classList.toggle("is-active", id === active);
        });

        if (!reduce) {
          revealInView();
          layers.forEach(function (el) {
            var parent = el.parentElement;
            if (!parent) return;
            var rect = parent.getBoundingClientRect();
            var mid = rect.top + rect.height * 0.5 - window.innerHeight * 0.5;
            var shift = Math.max(-120, Math.min(120, mid * -0.24));
            el.style.transform = "translate3d(0," + shift + "px,0)";
          });
          deepLayers.forEach(function (img, i) {
            var figure = img.parentElement;
            var rect = figure.getBoundingClientRect();
            var mid = rect.top + rect.height * 0.5 - window.innerHeight * 0.5;
            var factor = 0.16 + (i % 3) * 0.05;
            var shift = Math.max(-56, Math.min(56, mid * -factor));
            img.style.transform = "translate3d(0," + shift + "px,0) scale(1.14)";
          });
        }
        ticking = false;
      }

      function requestTick() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      }

      window.addEventListener("scroll", requestTick, { passive: true });
      onScroll();
    })();
  </script>
</body>
</html>
