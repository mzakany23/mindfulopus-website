  var moEnvironment = ({{ ph.reportingHosts | dump | safe }})[location.hostname];
  if (moEnvironment) {
    posthog.init('{{ ph.projectKey }}', {
      api_host: '{{ ph.apiHost }}',
      defaults: '2026-05-30',
      person_profiles: 'identified_only'
    });
    posthog.register({ environment: moEnvironment });
  }
  // capture exists only after init, so off the reporting hosts this is a no-op.
  window.moTrack = function (name, props) {
    if (window.posthog && typeof posthog.capture === 'function') posthog.capture(name, props);
  };
  // Stripe sends payers straight on to Zoom, so the site never sees the payment. Instead the
  // Reserve link carries this visitor's PostHog id as client_reference_id, Stripe stores it on
  // the checkout session, and payments are joined back to visits from Stripe's own records.
  function tagCheckout(link) {
    var id = window.posthog && typeof posthog.get_distinct_id === 'function' && posthog.get_distinct_id();
    if (!id) return;
    var url = new URL(link.href);
    // Stripe accepts letters, digits, dashes and underscores, up to 200 characters.
    url.searchParams.set('client_reference_id', String(id).replace(/[^A-Za-z0-9_-]/g, '_').slice(0, 200));
    link.href = url.toString();
  }
  // Story steps, one event per thing a visitor can choose to do:
  //   reserve_click   - StudentOpus Reserve (to Stripe); payment itself is read from Stripe
  //   interest_click  - StudentOpus "can't make it this month" list (Brevo)
  //   workbook_click  - free Well-Being Wheel signup on the homepage (Brevo)
  // Brevo links name their event with data-track, since every Brevo form shares one host.
  // Everything else (other clicks, pageviews, scroll depth, referrer and UTM) is PostHog's own.
  document.addEventListener('click', function (event) {
    var link = event.target.closest && event.target.closest('a[href]');
    if (!link) return;
    var section = link.closest('section[id]');
    var props = { placement: section ? section.id : null, page: location.pathname };
    if (link.hostname === 'buy.stripe.com') {
      moTrack('reserve_click', props);
      tagCheckout(link);
    }
    else if (link.dataset.track) moTrack(link.dataset.track, props);
  }, true);
</script>
