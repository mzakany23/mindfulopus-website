              {% for testimonial in testimonials.testimonials %}
              <article class="story">
                <blockquote>“{{ testimonial.quote | truncate(180) }}”</blockquote>
                <cite>
                  {% if testimonial.author and testimonial.author != "Anonymous" %}
                    {{ testimonial.author }}
                    {% if testimonial.role %}<span>{{ testimonial.role }}</span>{% endif %}
                  {% else %}
                    {{ testimonial.role or "Musician" }}
                  {% endif %}
                </cite>
              </article>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
