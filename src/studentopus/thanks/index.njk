---
permalink: /studentopus/thanks/
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>You're in | StudentOpus</title>
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #101816;
      --muted: #2a3c38;
      --teal: #2a7d7d;
      --teal-mid: #318989;
      --teal-deep: #1f6666;
      --foam: #f4f7f5;
      --paper: #ffffff;
      --line: rgba(16, 24, 22, 0.12);
      --radius-btn: 999px;
      --radius-panel: 28px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: "Source Sans Pro", sans-serif;
      font-size: 19px;
      line-height: 1.7;
      color: var(--ink);
      background: var(--foam);
    }
    header { padding: 1.5rem 1.35rem; }
    header img { height: 34px; width: auto; display: block; }
    main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1.35rem 4rem;
    }
    .panel {
      width: min(620px, 100%);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
      padding: 2.5rem 2rem;
      text-align: center;
    }
    h1 { font-size: 2.1rem; line-height: 1.2; margin: 0 0 0.75rem; }
    p { margin: 0 0 1rem; color: var(--muted); }
    .so-s { color: var(--ink); font-weight: 700; }
    .so-o { color: var(--teal); font-weight: 700; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      margin: 0.75rem 0 1.25rem;
      padding: 0 1.55rem;
      font-weight: 600;
      color: #fff;
      text-decoration: none;
      border-radius: var(--radius-btn);
      background: linear-gradient(135deg, var(--teal) 0%, var(--teal-deep) 100%);
      box-shadow: 0 6px 20px rgba(42, 125, 125, 0.32);
    }
    .btn:hover { background: linear-gradient(135deg, var(--teal-mid) 0%, var(--teal) 100%); }
    .small { font-size: 0.95rem; }
    .small a { color: var(--teal-deep); }
    @media (max-width: 520px) {
      .panel { padding: 2rem 1.25rem; }
      h1 { font-size: 1.75rem; }
      .btn { width: 100%; }
    }
  </style>
  {% include "partials/analytics.njk" %}
</head>
<body>
  <header>
    <a href="/studentopus/"><img src="/studentopus/assets/mindfulopus-wordmark.png" alt="MindfulOpus" /></a>
  </header>
  <main>
    <div class="panel">
      <h1>You're in. Thank you!</h1>
      <p>Your spot in this month's <span class="so-s">Student</span><span class="so-o">Opus</span> session is paid for, and your receipt from Stripe is on its way to your inbox.</p>
      {%- if studentopus.zoomRegistrationUrl %}
      <p>One last step: register for the Zoom session so you get the link to join.</p>
      <a class="btn" id="zoom-register" href="{{ studentopus.zoomRegistrationUrl }}">Register for the Zoom session</a>
      {%- endif %}
      <p class="small">Questions? Write to <a href="mailto:contact@mindfulopus.com">contact@mindfulopus.com</a>.</p>
    </div>
  </main>
  <script>
    // Stripe's Payment Link redirects here with ?session_id={CHECKOUT_SESSION_ID}.
    // Only a real checkout counts as a purchase; the session id lets a reload be de-duplicated.
    (function () {
      var sessionId = new URLSearchParams(location.search).get('session_id');
      if (sessionId) {
        moTrack('purchase', { product: 'studentopus', checkout_session_id: sessionId });
      }
      var zoom = document.getElementById('zoom-register');
      if (zoom) {
        zoom.addEventListener('click', function () {
          moTrack('zoom_register_click', { checkout_session_id: sessionId });
        });
      }
    })();
  </script>
</body>
</html>
