---
permalink: /flyers/
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Workshops &amp; Events — MindfulOpus</title>
  <meta name="description" content="MindfulOpus workshops and performance series at partner conservatories.">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/vendor/css/materialdesignicons.min.css" type="text/css">
  {% include "partials/flyer-chrome-styles.njk" %}
</head>
<body>
  {% include "partials/flyer-topbar.njk" %}

  <main class="flyer-page">
    <header class="flyer-page-header">
      <p class="eyebrow">Partner conservatories</p>
      <h1>Workshops &amp; Events</h1>
      <p class="lede">Browse MindfulOpus sessions by school — upcoming workshops and the full archive of past events.</p>
    </header>

    <div class="school-grid">
      {% for school in flyerSchools %}
      <a class="school-card" href="{{ school.url }}">
        <h2>{{ school.shortName }}</h2>
        <p class="meta">
          {{ school.name }}<br>
          {% if school.upcomingCount %}{{ school.upcomingCount }} upcoming{% endif %}
          {% if school.upcomingCount and school.pastCount %} · {% endif %}
          {% if school.pastCount %}{{ school.pastCount }} past{% endif %}
          {% if not school.upcomingCount and not school.pastCount %}No events yet{% endif %}
        </p>
        <span class="cta">View events <i class="mdi mdi-arrow-right"></i></span>
      </a>
      {% endfor %}
    </div>
  </main>

  <div class="flyer-footer">
    &copy; {{ page.date.getFullYear() }} <a href="/">MindfulOpus</a>
  </div>
</body>
</html>
